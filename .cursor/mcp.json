{
  "mcpServers": {
    "filesystem": {
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "@modelcontextprotocol/server-filesystem", "${workspaceFolder}"]
    },
    "github": {
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}" }
    },
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "@upstash/context7-mcp"]
    },
    "shadcn": {
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "shadcn@latest", "mcp"]
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "@playwright/mcp"]
    },
    "sequential-thinking": {
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "obsidian": {
      "command": "node",
      "args": ["${workspaceFolder}/scripts/mcp-obsidian-vault.mjs"]
    }
  }
}

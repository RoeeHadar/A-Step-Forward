{
  "mcpServers": {
    "filesystem": {
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "@modelcontextprotocol/server-filesystem", "${workspaceFolder}"]
    },
    "github": {
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}" }
    },
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "@upstash/context7-mcp"]
    },
    "shadcn": {
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "@shadcn/ui-mcp"]
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "@playwright/mcp"]
    },
    "postgres": {
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "@modelcontextprotocol/server-postgres", "${env:DATABASE_URL_SYNC}"]
    },
    "sequential-thinking": {
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "fetch": {
      "command": "cmd",
      "args": ["/c", "npx.cmd", "-y", "@modelcontextprotocol/server-fetch"]
    },
    "memory-project": {
      "command": "python",
      "args": ["-m", "memory_mcp.server"],
      "cwd": "${workspaceFolder}/mcp-servers/memory",
      "env": {
        "DATABASE_URL": "${env:DATABASE_URL}",
        "REDIS_URL": "${env:REDIS_URL}"
      }
    },
    "graphrag-project": {
      "command": "python",
      "args": ["-m", "graphrag_mcp.server"],
      "cwd": "${workspaceFolder}/mcp-servers/graphrag",
      "env": {
        "NEO4J_URI": "${env:NEO4J_URI}",
        "NEO4J_USER": "${env:NEO4J_USER}",
        "NEO4J_PASSWORD": "${env:NEO4J_PASSWORD}",
        "DATABASE_URL": "${env:DATABASE_URL}"
      }
    },
    "curriculum-project": {
      "command": "python",
      "args": ["-m", "curriculum_mcp.server"],
      "cwd": "${workspaceFolder}/mcp-servers/curriculum",
      "env": {
        "DATABASE_URL": "${env:DATABASE_URL}"
      }
    },
    "progress-project": {
      "command": "python",
      "args": ["-m", "progress_mcp.server"],
      "cwd": "${workspaceFolder}/mcp-servers/progress",
      "env": {
        "DATABASE_URL": "${env:DATABASE_URL}",
        "REDIS_URL": "${env:REDIS_URL}"
      }
    },
    "obsidian": {
      "command": "cmd",
      "args": ["/c", "\"${workspaceFolder}\\scripts\\mcp-obsidian-vault.cmd\""]
    }
  }
}

{
  "name": "a-step-forward",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @asf/web dev",
    "build": "pnpm --filter @asf/web build",
    "lint": "pnpm --filter @asf/web lint",
    "typecheck": "pnpm --filter @asf/web typecheck",
    "test": "pnpm --filter @asf/web test",
    "test:scripts": "node --test scripts/lib/normalize-lesson.test.mjs scripts/lib/question-pipeline.test.mjs",
    "e2e": "pnpm --filter @asf/web e2e",
    "questions:ingest": "node scripts/ingest-question-sources.mjs",
    "questions:pipeline": "node scripts/pipeline-run.mjs",
    "audit:lessons:strict": "node scripts/audit-lesson-strict.mjs",
    "audit:lessons:depth": "node scripts/audit-lesson-depth.mjs",
    "mcp:obsidian": "node scripts/mcp-obsidian-vault.mjs",
    "mcp:install-obsidian": "powershell -ExecutionPolicy Bypass -File scripts/install-cursor-obsidian-mcp.ps1",
    "vault:sync": "node scripts/sync-obsidian-concepts.mjs && node scripts/sync-obsidian-expansion.mjs",
    "vault:build-kg": "node scripts/build-kg-json.mjs",
    "vault:sync-concepts": "node scripts/sync-obsidian-concepts.mjs",
    "vault:sync-expansion": "node scripts/sync-obsidian-expansion.mjs"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@bitbonsai/mcpvault": "0.12.1",
    "js-yaml": "^5.1.0"
  }
}

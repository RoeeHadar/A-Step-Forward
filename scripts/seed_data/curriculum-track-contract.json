  "five_pt_denylist": [
    {
      "id": "epsilon_delta",
      "pattern": "ε\\s*[-–—]\\s*δ|\\\\varepsilon\\s*[-–—]\\s*\\\\delta|\\$\\\\varepsilon\\$-\\$\\\\delta\\$|epsilon\\s*[-–—]\\s*delta|Epsilon\\s*[-–—]\\s*Delta|εδ|אפסילון\\s*[-–—]\\s*דלתא",
      "note": "Formal ε-δ limit proofs are university, not MoE 5pt"
    },
    {
      "id": "limit_def_derivative",
      "pattern": "definition of (the )?derivative via limits|limit definition of (the )?derivative|f'\\(x\\)\\s*=\\s*\\\\?lim|derivative as a limit",
      "note": "Formal limit definition of derivative is uni / calc 1; 5pt uses rules + geometric meaning"
    },
    {
      "id": "lhopital",
      "pattern": "L['’]?H[oô]pital|L\\\\'?Hopital|לופיטל|ל'הופיטל",
      "note": "L'Hôpital is not core MoE 5pt content"
    },
    {
      "id": "weierstrass",
      "pattern": "Weierstrass|ויירשטראס",
      "note": "Analysis theorem — university"
    },
    {
      "id": "rolle_mean_value_formal",
      "pattern": "Rolle'?s theorem proof|Mean Value Theorem proof|proof of (Rolle|the Mean Value)|הוכחת משפט רול|הוכחת משפט ערך הביניים",
      "note": "Formal MVT/Rolle proofs belong in uni analysis"
    }
  ],
  "university_denylist": [
    {
      "id": "bagrut_word",
      "pattern": "\\bBagrut\\b|בגרות",
      "note": "University lessons must not use Bagrut / MoE exam framing"
    },
    {
      "id": "exam_points_voice",
      "pattern": "points on the exam|on the Bagrut|Bagrut paper|exam tip for Bagrut|במבחן הבגרות|נקודות במבחן|שאלון\\s*\\d{3}",
      "note": "MoE exam-points / questionnaire voice"
    },
    {
      "id": "moe_units_voice",
      "pattern": "\\b[345]\\s*units?\\b|\\b[345]-unit\\b|\\b[345]pt\\s+Bagrut\\b|יחידות לימוד",
      "note": "HS unit-track voice on university lessons"
    }
  ],

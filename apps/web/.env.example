# Copy to apps/web/.env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=https://a-step-forward-waij.vercel.app
NEXT_PUBLIC_APP_NAME=A Step Forward
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Postgres (memory, plans, quizzes, chat turns)
DATABASE_URL=

# Cron routes (/api/cron/dream-memory, /api/cron/consolidate-memory) — random secret
CRON_SECRET=

# ── Book a Lesson (Google Calendar + private contact secrets) ──
# Google Cloud OAuth client (Calendar API enabled). Redirect URI must match:
#   {NEXT_PUBLIC_APP_URL}/api/book/gcal/oauth/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional overrides:
# GOOGLE_CALENDAR_REDIRECT_URI=
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_WEBHOOK_URL=https://your-domain/api/book/gcal/webhook
# GOOGLE_CALENDAR_WEBHOOK_TOKEN=random-shared-secret
# GOOGLE_CALENDAR_REFRESH_TOKEN=  # optional bootstrap; prefer admin Connect flow
# AES key for sealing refresh token / phone / address in Neon (min 8 chars)
BOOKING_SECRETS_KEY=
# Optional env fallbacks (also editable in /admin/bookings):
# BOOKING_ADMIN_PHONE=
# BOOKING_ADMIN_ADDRESS=
# BOOKING_MEETING_LINK=
# Email on new booking requests (Resend):
# RESEND_API_KEY=
# RESEND_FROM=A Step Forward <bookings@yourdomain.com>
# BOOKING_NOTIFY_EMAIL=roeehadar@gmail.com

# ── LLM (OpenAI-compatible: Groq, Ollama, vLLM, Together, OpenRouter) ──
# Unified vars (preferred):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Volume-first primary (Groq free: 14.4K RPD); Scout + 70B as quality fallback (1K RPD each)
LLM_PRIMARY_MODEL=llama-3.1-8b-instant
LLM_CHEAP_MODEL=llama-3.1-8b-instant
LLM_FALLBACK_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,llama-3.3-70b-versatile
# Legacy Groq aliases (still supported):
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Local Ollama example:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_PRIMARY_MODEL=qwen2.5:32b-instruct

# E2E tests (optional)
E2E_CLERK_EMAIL=
E2E_CLERK_PASSWORD=

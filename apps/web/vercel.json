{
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @asf/web build",
  "outputDirectory": ".next",
  "env": {
    "NEXT_PUBLIC_APP_NAME": "A Step Forward"
  },
  "crons": [
    {
      "path": "/api/cron/dream-memory?limit=50",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron/consolidate-memory?limit=25",
      "schedule": "0 2 * * 1"
    },
    {
      "path": "/api/cron/weekly-gate-due?limit=150",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/grade-attempts?limit=8",
      "schedule": "0 3 * * *"
    }
  ]
}
